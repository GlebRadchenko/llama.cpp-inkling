From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gleb Radchenko <14540409+GlebRadchenko@users.noreply.github.com>
Date: Tue, 24 Nov 2026 20:15:13 +0100
Subject: [PATCH 05/11] inkling2: one-query relative bias gathered then
 projected with the sink in the attention; padded bias table at load; no
 per-token scale copy for one token

3793 -> 3583 dispatches per decode token. KLD vs CPU on the ub=1 path 0.00125 (stock 0.00127).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/llama-graph.cpp     |  5 ++++-
 src/models/inkling2.cpp | 20 +++++++++++++++++++-
 src/models/models.h     |  2 ++
 3 files changed, 25 insertions(+), 2 deletions(-)

diff --git a/src/llama-graph.cpp b/src/llama-graph.cpp
index 279ce28..e91bd4a 100644
--- a/src/llama-graph.cpp
+++ b/src/llama-graph.cpp
@@ -2031,7 +2031,10 @@ ggml_tensor * llm_graph_context::build_lora_mm_id(
         const int64_t n_expert = w_s->ne[0];
         const int64_t n_tokens = cur->ne[2];
         ggml_tensor * s = ggml_reshape_3d(ctx0, w_s, 1, n_expert, 1);
-        s = ggml_repeat_4d(ctx0, s, 1, n_expert, n_tokens, 1);
+        // get_rows pairs the batches of s and ids: one token needs no copy per token
+        if (n_tokens > 1) {
+            s = ggml_repeat_4d(ctx0, s, 1, n_expert, n_tokens, 1);
+        }
         s = ggml_get_rows(ctx0, s, ids);
         res = ggml_mul(ctx0, res, s);
     }
diff --git a/src/models/inkling2.cpp b/src/models/inkling2.cpp
index 39d850f..a215c57 100644
--- a/src/models/inkling2.cpp
+++ b/src/models/inkling2.cpp
@@ -202,6 +202,11 @@ void llama_model_inkling2::post_load_data() {
             }
             conv_folded[w] = new_derived_weight(w, GGML_TYPE_F32, w->ne[0], w->ne[1], 1, v.data());
         }
+        if (ggml_tensor * w = layer.attn_rel_bias; w && w->type == GGML_TYPE_F32 && ggml_is_contiguous(w)) {
+            std::vector<float> v(w->ne[0]*(w->ne[1] + 1), 0.0f);
+            ggml_backend_tensor_get(w, v.data(), 0, ggml_nbytes(w));
+            rel_bias_padded[w] = new_derived_weight(w, GGML_TYPE_F32, w->ne[0], w->ne[1] + 1, 1, v.data());
+        }
     }
 }
 
@@ -677,9 +682,22 @@ ggml_tensor * llama_model_inkling2::graph::build_layer(int il, int ip, ggml_tens
             if (v_rot) {
                 cur = llama_mul_mat_hadamard(ctx0, cur, v_rot);
             }
+        } else if (n_tokens == 1) {
+            // one query: gather its bias rows, then project straight into the [n_kv, 1, n_head] bias,
+            // and its per-query sink is a per-head sink of the attention
+            const auto & padded = static_cast<const llama_model_inkling2 &>(model).rel_bias_padded;
+            const auto it = padded.find(layer.attn_rel_bias);
+            ggml_tensor * table = it != padded.end() ? it->second : ggml_pad(ctx0, layer.attn_rel_bias, 0, 1, 0, 0);
+            ggml_tensor * kq_b = ggml_mul_mat(ctx0, ggml_get_rows(ctx0, table, rel_pos), Rcur);
+            kq_b = ggml_reshape_4d(ctx0, kq_b, n_kv, 1, n_head, 1);
+            cb(kq_b, "kq_b", il);
+            cur = build_attn(inp, nullptr, nullptr, nullptr, Qcur, Kcur, Vcur, kq_b, ggml_reshape_1d(ctx0, sinks, n_head),
+                    1.0f/sqrtf(n_embd_head), il, 0);
         } else {
             // project before gathering: only the gathered bias is n_kv x n_tokens x n_head
-            ggml_tensor * table = ggml_mul_mat(ctx0, ggml_pad(ctx0, layer.attn_rel_bias, 0, 1, 0, 0), Rcur);
+            const auto & padded = static_cast<const llama_model_inkling2 &>(model).rel_bias_padded;
+            const auto it = padded.find(layer.attn_rel_bias);
+            ggml_tensor * table = ggml_mul_mat(ctx0, it != padded.end() ? it->second : ggml_pad(ctx0, layer.attn_rel_bias, 0, 1, 0, 0), Rcur);
 
             // per-query sink t: exp(s - t)/(1 + sum(exp(s - t))) = exp(s)/(exp(t) + sum(exp(s)))
             table = ggml_sub(ctx0, table, ggml_reshape_3d(ctx0, sinks, 1, n_head, n_tokens));
diff --git a/src/models/models.h b/src/models/models.h
index 33d00e6..00fed97 100644
--- a/src/models/models.h
+++ b/src/models/models.h
@@ -2593,6 +2593,8 @@ struct llama_model_inkling2 : public llama_model_base {
     void post_load_data() override;
     // derived at load: (cur + conv(x, w))*s as one conv, by source weight (the current input is the last tap)
     std::unordered_map<const ggml_tensor *, ggml_tensor *> conv_folded;
+    // derived at load: the relative-bias tables with the zero row of the out-of-extent positions, by source weight
+    std::unordered_map<const ggml_tensor *, ggml_tensor *> rel_bias_padded;
 
     struct graph : public llm_graph_context {
         graph(const llm_graph_params & params);
