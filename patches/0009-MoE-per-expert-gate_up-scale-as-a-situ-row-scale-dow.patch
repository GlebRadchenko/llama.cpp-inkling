From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gleb Radchenko <14540409+GlebRadchenko@users.noreply.github.com>
Date: Tue, 24 Nov 2026 20:15:14 +0100
Subject: [PATCH 09/11] MoE: per-expert gate_up scale as a situ row scale, down
 scale folded into the router weights

Two serial muls off the expert path. A/B tg64 35.2 -> 35.8 tok/s. KLD vs CPU 0.00120 (ub 512), 0.00119 (ub 1).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ggml/include/ggml.h                     |  9 +++++++++
 ggml/src/ggml-cpu/ops.cpp               |  5 +++--
 ggml/src/ggml-metal/ggml-metal-device.m |  3 ++-
 ggml/src/ggml-metal/ggml-metal-impl.h   |  1 +
 ggml/src/ggml-metal/ggml-metal-ops.cpp  | 16 ++++++++++++++-
 ggml/src/ggml-metal/kernels/unary.metal |  7 +++++--
 ggml/src/ggml.c                         | 14 +++++++++++++
 src/llama-graph.cpp                     | 26 +++++++++++++++++++------
 src/llama-graph.h                       |  4 +++-
 9 files changed, 72 insertions(+), 13 deletions(-)

diff --git a/ggml/include/ggml.h b/ggml/include/ggml.h
index 12a229f..4b90f23 100644
--- a/ggml/include/ggml.h
+++ b/ggml/include/ggml.h
@@ -1237,6 +1237,15 @@ extern "C" {
             float                 beta,
             float                 lb);
 
+    // ggml_situ of a*s and b*s, s one value per row of a: [1, ne1, ne2, ne3]
+    GGML_API struct ggml_tensor * ggml_situ_scaled(
+            struct ggml_context * ctx,
+            struct ggml_tensor  * a,
+            struct ggml_tensor  * b,
+            struct ggml_tensor  * s,
+            float                 beta,
+            float                 lb);
+
     GGML_API struct ggml_tensor * ggml_swiglu_oai(
             struct ggml_context * ctx,
             struct ggml_tensor  * a,
diff --git a/ggml/src/ggml-cpu/ops.cpp b/ggml/src/ggml-cpu/ops.cpp
index c68a266..65ea06d 100644
--- a/ggml/src/ggml-cpu/ops.cpp
+++ b/ggml/src/ggml-cpu/ops.cpp
@@ -3641,9 +3641,10 @@ static void ggml_compute_forward_situ_f32(
             src1_p += swapped ? 0 : nc;
         }
 
+        const float rs = dst->src[2] ? ((const float *) dst->src[2]->data)[i1] : 1.0f;
         for (int k = 0; k < nc; k++) {
-            const float g = src0_p[k];
-            const float u = src1_p[k];
+            const float g = dst->src[2] ? src0_p[k]*rs : src0_p[k];
+            const float u = dst->src[2] ? src1_p[k]*rs : src1_p[k];
             const float act = beta*tanhf(g*(1.0f/beta)) * (1.0f/(1.0f + expf(-g)));
             dst_p[k] = act * (lb > 0.0f ? lb*tanhf(u*(1.0f/lb)) : u);
         }
diff --git a/ggml/src/ggml-metal/ggml-metal-device.m b/ggml/src/ggml-metal/ggml-metal-device.m
index 9c12e17..d4fb6cb 100644
--- a/ggml/src/ggml-metal/ggml-metal-device.m
+++ b/ggml/src/ggml-metal/ggml-metal-device.m
@@ -1626,7 +1626,8 @@ bool ggml_metal_device_supports_op(ggml_metal_device_t dev, const struct ggml_te
                 case GGML_GLU_OP_SWIGLU_CLAMP:
                     return ggml_is_contiguous_1(op->src[0]) && (op->src[0]->type == GGML_TYPE_F32 || op->src[0]->type == GGML_TYPE_F16);
                 case GGML_GLU_OP_SITU:
-                    return ggml_is_contiguous_1(op->src[0]) && op->src[0]->type == GGML_TYPE_F32;
+                    return ggml_is_contiguous_1(op->src[0]) && op->src[0]->type == GGML_TYPE_F32 &&
+                        (!op->src[2] || (op->src[2]->type == GGML_TYPE_F32 && ggml_is_contiguous(op->src[2])));
                default:
                     return false;
             }
diff --git a/ggml/src/ggml-metal/ggml-metal-impl.h b/ggml/src/ggml-metal/ggml-metal-impl.h
index 91453d6..be9d65e 100644
--- a/ggml/src/ggml-metal/ggml-metal-impl.h
+++ b/ggml/src/ggml-metal/ggml-metal-impl.h
@@ -889,6 +889,7 @@ typedef struct{
     int32_t  i10;
     float    alpha;
     float    limit;
+    int32_t  has_s; // situ: src[2] holds a scale per row
 } ggml_metal_kargs_glu;
 
 typedef struct {
diff --git a/ggml/src/ggml-metal/ggml-metal-ops.cpp b/ggml/src/ggml-metal/ggml-metal-ops.cpp
index dcf4f63..3f46924 100644
--- a/ggml/src/ggml-metal/ggml-metal-ops.cpp
+++ b/ggml/src/ggml-metal/ggml-metal-ops.cpp
@@ -552,7 +552,18 @@ int ggml_metal_op_encode(ggml_metal_op_t ctx, int idx) {
         ggml_metal_encoder_debug_group_push(ctx->enc, ggml_op_desc(ctx->node(idx)));
     }
 
+    extern int ggml_metal_n_dispatch;
+    const int n_disp0 = ggml_metal_n_dispatch;
     int res = ggml_metal_op_encode_impl(ctx, idx);
+    {
+        // experiment: GGML_METAL_TIMING=5 prints the dispatches of the encode calls of one big graph, keyed by op (+ fused span)
+        static int mode = -1; if (mode < 0) { const char * e = getenv("GGML_METAL_TIMING"); mode = e ? atoi(e) : 0; }
+        if (mode == 5 && ctx->n_nodes() > 3000 && ggml_metal_n_dispatch > n_disp0) {
+            const ggml_tensor * t = ctx->node(idx);
+            fprintf(stderr, "enc %-14s span=%d disp=%d %s\n", t->op == GGML_OP_UNARY ? ggml_unary_op_name(ggml_get_unary_op(t)) : ggml_op_name(t->op),
+                res, ggml_metal_n_dispatch - n_disp0, t->name);
+        }
+    }
     if (idx + res > ctx->n_nodes()) {
         GGML_ABORT("fusion error: nodes spanning multiple encoders have been fused. this indicates a bug in the fusion logic %s",
                 "https://github.com/ggml-org/llama.cpp/pull/14849");
@@ -1019,7 +1030,8 @@ int ggml_metal_op_glu(ggml_metal_op_t ctx, int idx) {
         /*.i00  =*/ op->src[1] ? 0 : i00,
         /*.i10  =*/ op->src[1] ? 0 : i10,
         /*.alpha=*/ alpha,
-        /*.limit=*/ limit
+        /*.limit=*/ limit,
+        /*.has_s=*/ op->src[2] != nullptr,
     };
 
     const int64_t nrows = ggml_nrows(op->src[0]);
@@ -1037,6 +1049,8 @@ int ggml_metal_op_glu(ggml_metal_op_t ctx, int idx) {
         ggml_metal_encoder_set_buffer  (enc, ggml_metal_get_buffer_id(op->src[0]), 2);
     }
     ggml_metal_encoder_set_buffer  (enc, ggml_metal_get_buffer_id(op),         3);
+    // situ: the per-row scale (any bound buffer otherwise, the kernel does not read it)
+    ggml_metal_encoder_set_buffer  (enc, ggml_metal_get_buffer_id(op->src[2] ? op->src[2] : op->src[0]), 4);
 
     ggml_metal_encoder_dispatch_threadgroups(enc, nk, nrows, 1, nth, 1, 1);
 
diff --git a/ggml/src/ggml-metal/kernels/unary.metal b/ggml/src/ggml-metal/kernels/unary.metal
index 7cf14bc..3ab34c0 100644
--- a/ggml/src/ggml-metal/kernels/unary.metal
+++ b/ggml/src/ggml-metal/kernels/unary.metal
@@ -350,6 +350,7 @@ kernel void kernel_situ_f32(
         device const char * src0,
         device const char * src1,
         device       char * dst,
+        device const float * rows, // per-row scale when args.has_s
         uint2 tgpig[[threadgroup_position_in_grid]],
         uint2 tpitg[[thread_position_in_threadgroup]],
         uint2   ntg[[threads_per_threadgroup]],
@@ -360,10 +361,12 @@ kernel void kernel_situ_f32(
 
     const float beta = args.alpha;
     const float lb   = args.limit;
+    const bool  has_s = args.has_s != 0;
+    const float rs    = has_s ? rows[tgpig.y] : 1.0f;
 
     for (int i0 = tgpig.x*ntg.x + tpitg.x; i0 < args.ne0; i0 += ntg.x*ntgs.x) {
-        const float g = src0_row[i0];
-        const float u = src1_row[i0];
+        const float g = has_s ? src0_row[i0]*rs : src0_row[i0];
+        const float u = has_s ? src1_row[i0]*rs : src1_row[i0];
 
         const float act = (beta*precise::tanh((1.0f/beta)*g)) * (1 / (1 + exp(-g)));
 
diff --git a/ggml/src/ggml.c b/ggml/src/ggml.c
index 787ade0..1d931eb 100644
--- a/ggml/src/ggml.c
+++ b/ggml/src/ggml.c
@@ -3208,6 +3208,20 @@ struct ggml_tensor * ggml_situ(
     return result;
 }
 
+struct ggml_tensor * ggml_situ_scaled(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * a,
+        struct ggml_tensor  * b,
+        struct ggml_tensor  * s,
+        float                 beta,
+        float                 lb) {
+    GGML_ASSERT(s->type == GGML_TYPE_F32 && ggml_is_contiguous(s) && s->ne[0] == 1 && ggml_nelements(s) == ggml_nrows(a));
+    struct ggml_tensor * result = ggml_situ(ctx, a, b, beta, lb);
+    result->src[2] = s;
+
+    return result;
+}
+
 struct ggml_tensor * ggml_swiglu_oai(
         struct ggml_context * ctx,
         struct ggml_tensor  * a,
diff --git a/src/llama-graph.cpp b/src/llama-graph.cpp
index d2acddd..8de5cac 100644
--- a/src/llama-graph.cpp
+++ b/src/llama-graph.cpp
@@ -1959,7 +1959,8 @@ ggml_tensor * llm_graph_context::build_lora_mm_id(
           ggml_tensor * cur, // ggml_tensor * b
           ggml_tensor * ids,
           ggml_tensor * slots,
-                 bool   cached) const {
+                 bool   cached,
+          ggml_tensor ** s_rows) const {
     ggml_tensor * w_s = model.get_w_scale(w);
 
     // as in build_lora_mm: the folded weight reads the transformed input, the LoRA delta reads `cur`
@@ -1985,7 +1986,11 @@ ggml_tensor * llm_graph_context::build_lora_mm_id(
             s = ggml_repeat_4d(ctx0, s, 1, n_expert, n_tokens, 1);
         }
         s = ggml_get_rows(ctx0, s, ids);
-        res = ggml_mul(ctx0, res, s);
+        if (s_rows && loras->empty()) {
+            *s_rows = s;
+        } else {
+            res = ggml_mul(ctx0, res, s);
+        }
     }
     for (const auto & lora : *loras) {
         llama_adapter_lora_weight * lw = lora.first->get_weight(w);
@@ -2599,12 +2604,19 @@ ggml_tensor * llm_graph_context::build_moe_ffn(
 
     // the experts selected by mm_ids, up to the down projection, from the MoE cache if cached
     // ids are the selected experts, for the biases and scales
+    // the per-expert down scale, gathered per row, when it is folded into the router weights
+    ggml_tensor * down_s = nullptr;
+
     auto build_experts = [&](ggml_tensor * cur, ggml_tensor * ids, ggml_tensor * mm_ids, bool cached) {
         ggml_tensor * up = nullptr;
 
+        // situ takes the per-expert gate_up scale as a row scale, the down scale joins the router weights
+        ggml_tensor * gate_up_s = nullptr;
+        const bool fold_scales = type_op == LLM_FFN_SITU && !gate_up_exps_b && !mm_ids;
+
         if (gate_up_exps) {
             // merged gate_up path: one mul_mat_id, then split into gate and up views
-            ggml_tensor * gate_up = build_lora_mm_id(gate_up_exps, cur, ids, mm_ids, cached); // [n_ff*2, n_expert_used, n_tokens]
+            ggml_tensor * gate_up = build_lora_mm_id(gate_up_exps, cur, ids, mm_ids, cached, fold_scales ? &gate_up_s : nullptr); // [n_ff*2, n_expert_used, n_tokens]
             cb(gate_up, "ffn_moe_gate_up", il);
 
             if (gate_up_exps_b) {
@@ -2680,7 +2692,7 @@ ggml_tensor * llm_graph_context::build_moe_ffn(
                     const float beta = hparams.situ_beta;
                     const float lb   = hparams.situ_linear_beta;
 
-                    cur = ggml_situ(ctx0, cur, up, beta, lb);
+                    cur = gate_up_s ? ggml_situ_scaled(ctx0, cur, up, gate_up_s, beta, lb) : ggml_situ(ctx0, cur, up, beta, lb);
                     cb(cur, "ffn_moe_situ", il);
                 } break;
             case LLM_FFN_GELU:
@@ -2731,7 +2743,8 @@ ggml_tensor * llm_graph_context::build_moe_ffn(
             cur = amax_src1.res;
         }
 
-        ggml_tensor * experts = build_lora_mm_id(down_exps, cur, ids, mm_ids, cached); // [n_embd, n_expert_used, n_tokens]
+        ggml_tensor * experts = build_lora_mm_id(down_exps, cur, ids, mm_ids, cached,
+                fold_scales && !down_exps_b && !post_exp_norm && !weight_before_ffn ? &down_s : nullptr); // [n_embd, n_expert_used, n_tokens]
         //ggml_prec_set_src(experts, GGML_PREC_BF16, 1); // (see TODO above)
         cb(experts, "ffn_moe_down", il);
 
@@ -2762,7 +2775,8 @@ ggml_tensor * llm_graph_context::build_moe_ffn(
     }
 
     if (!weight_before_ffn) {
-        experts = ggml_mul(ctx0, experts, weights);
+        // the down scale times the router weights: [1, n_used, n_tokens], off the path of the experts
+        experts = ggml_mul(ctx0, experts, down_s ? ggml_mul(ctx0, weights, down_s) : weights);
         cb(experts, "ffn_moe_weighted", il);
     }
 
diff --git a/src/llama-graph.h b/src/llama-graph.h
index 59731c4..f56c43b 100644
--- a/src/llama-graph.h
+++ b/src/llama-graph.h
@@ -1204,12 +1204,14 @@ struct llm_graph_context {
 
     // do mat_mul_id, while optionally apply lora and per-expert scale
     // if slots is set, the experts are selected by slots instead of ids, from the MoE cache if cached (see llama_moe_cache::build_lookup)
+    // s_rows: when set and w has per-expert scales, receives them gathered per row [1, n_used, n_tokens] instead of applying them
     ggml_tensor * build_lora_mm_id(
               ggml_tensor * w,   // ggml_tensor * as
               ggml_tensor * cur, // ggml_tensor * b
               ggml_tensor * ids,
               ggml_tensor * slots  = nullptr,
-                     bool   cached = true) const;
+                     bool   cached = true,
+              ggml_tensor ** s_rows = nullptr) const;
 
     // rescale `cur` (the src1 of a matmul) by a power of two, computed from its maximum absolute
     // keep both individual values and Q8 activation block sums within F16 range
