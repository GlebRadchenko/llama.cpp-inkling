+// GGML_GLU_OP_SITU: softcapped SwiGLU of Inkling2 MoE, a and b strided views of one gate_up row like the model
+// GGML_OP_DEPTH_MIX
+struct test_depth_mix : public test_case {
+    const int64_t n_embd, n_q, n_b, n_tok;
+
+    std::string vars() override { return VARS_TO_STR4(n_embd, n_q, n_b, n_tok); }
+
+    test_depth_mix(int64_t n_embd = 2304, int64_t n_q = 1, int64_t n_b = 3, int64_t n_tok = 1) : n_embd(n_embd), n_q(n_q), n_b(n_b), n_tok(n_tok) {}
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        ggml_tensor * cur = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, n_embd, n_tok);
+        ggml_tensor * qry = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, n_embd, n_q);
+        ggml_tensor * st  = n_b ? ggml_new_tensor_3d(ctx, GGML_TYPE_F32, n_embd, n_b, n_tok) : nullptr;
+        return ggml_depth_mix(ctx, cur, qry, st, 1.0f/sqrtf(n_embd), 1e-6f);
+    }
+};
+
+// GGML_OP_LOOP_GATE
+struct test_loop_gate : public test_case {
+    const int64_t E, n, B;
+    const bool bx, bw, nonorm;
+
+    std::string vars() override { return VARS_TO_STR6(E, n, B, bx, bw, nonorm); }
+
+    test_loop_gate(int64_t E = 2304, int64_t n = 1, int64_t B = 3, bool bx = true, bool bw = true, bool nonorm = false) : E(E), n(n), B(B), bx(bx), bw(bw), nonorm(nonorm) {}
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        ggml_tensor * fg = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, 2*E, n, B);
+        ggml_tensor * x  = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, E, n, bx ? 1 : B);
+        // m as a permuted view, like the messages of the model
+        ggml_tensor * mm = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, E, B + 1, n);
+        ggml_tensor * m  = ggml_permute(ctx, ggml_view_3d(ctx, mm, E, B, n, mm->nb[1], mm->nb[2], 0), 0, 2, 1, 3);
+        ggml_tensor * w  = nonorm ? nullptr : ggml_new_tensor_2d(ctx, GGML_TYPE_F32, E, bw ? 1 : B);
+        return ggml_loop_gate(ctx, fg, x, m, w, 1e-6f);
+    }
+};
+
+struct test_situ : public test_case {
+    const std::array<int64_t, 4> ne_a;
+    float beta;
+    float lb;
+
+    std::string vars() override { return VARS_TO_STR4(ne_a, beta, lb, scaled); }
+
+    bool scaled;
+
+    test_situ(std::array<int64_t, 4> ne_a = {1152, 8, 2, 1}, float beta = 4.0f, float lb = 25.0f, bool scaled = false) : ne_a(ne_a), beta(beta), lb(lb), scaled(scaled) {}
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        auto ne = ne_a; ne[0] *= 2;
+        ggml_tensor * gu = ggml_new_tensor(ctx, GGML_TYPE_F32, 4, ne.data());
+        ggml_set_param(gu);
+        ggml_tensor * a = ggml_view_4d(ctx, gu, ne_a[0], ne_a[1], ne_a[2], ne_a[3], gu->nb[1], gu->nb[2], gu->nb[3], 0);
+        ggml_tensor * b = ggml_view_4d(ctx, gu, ne_a[0], ne_a[1], ne_a[2], ne_a[3], gu->nb[1], gu->nb[2], gu->nb[3], ne_a[0]*ggml_element_size(gu));
+        if (scaled) {
+            ggml_tensor * rs = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, 1, ne_a[1], ne_a[2], ne_a[3]);
+            return ggml_situ_scaled(ctx, a, b, rs, beta, lb);
+        }
+        return ggml_situ(ctx, a, b, beta, lb);
+    }
+
+    void initialize_tensors(ggml_context * ctx) override {
+        for (ggml_tensor * t = ggml_get_first_tensor(ctx); t != NULL; t = ggml_get_next_tensor(ctx, t)) {
+            init_tensor_uniform(t, -60.f, 60.f); // past both softcaps
+        }
+    }
+};
